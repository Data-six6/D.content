# Meateka — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to GitHub.

# ─── Gemini AI (for ai/ module and ai_bridge.py) ───
GOOGLE_API_KEY_1=your_first_gemini_key_here
GOOGLE_API_KEY_2=your_second_gemini_key_here
GOOGLE_API_KEY_3=your_third_gemini_key_here

# ─── Backend (Node.js) ───
BRIDGE_URL=http://127.0.0.1:8000
JWT_SECRET=your-jwt-secret-here
APP_ENV=development
API_PORT=5000

# ─── Database (MySQL) ───
DB_HOST=localhost
DB_PORT=3306
DB_NAME=digital_content_predictor
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ─── Frontend ───
VITE_API_BASE_URL=http://localhost:5000/api
